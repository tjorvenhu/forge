{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FORGE",
  "version": "0.1.0",
  "identifier": "de.vanturis.forge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FORGE",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark",
        "backgroundColor": "#14171d",
        "center": true
      },
      {
        "label": "chat",
        "create": false,
        "title": "FORGE",
        "width": 760,
        "height": 900,
        "minWidth": 520,
        "minHeight": 500,
        "theme": "Dark",
        "backgroundColor": "#14171d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.githubusercontent.com; font-src 'self' data:; media-src 'self' blob:; frame-src blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "runtime/": "runtime/",
      "../../../LICENSE.md": "LICENSE.md",
      "../../../NOTICE": "NOTICE",
      "../../../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "shortDescription": "Desktop-GUI für Claude Code",
    "longDescription": "FORGE ist eine Desktop-App für Claude Code: Projekte und Sessions, parallele Agenten in eigenen Git-Worktrees, Git-Ansicht, Projektwissen und Steuerung per Telefon.",
    "publisher": "Vanturis",
    "copyright": "Copyright © 2026 Vanturis UG (haftungsbeschränkt)",
    "homepage": "https://vanturis.de",
    "category": "DeveloperTool"
  }
}
