{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FORGE",
  "version": "0.1.0",
  "identifier": "de.vanturis.forge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FORGE",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "theme": "Dark",
        "transparent": true,
        "windowEffects": { "effects": ["mica"] },
        "center": true
      },
      {
        "label": "chat",
        "create": false,
        "title": "FORGE",
        "width": 760,
        "height": 900,
        "minWidth": 520,
        "minHeight": 500,
        "theme": "Dark",
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://avatars.githubusercontent.com; font-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "runtime/**/*"
    ],
    "shortDescription": "Desktop-GUI für Claude Code",
    "category": "DeveloperTool"
  }
}
