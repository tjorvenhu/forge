{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"],
        "recommends": ["gstreamer1.0-plugins-good", "gstreamer1.0-pulseaudio", "git"]
      }
    }
  }
}
