{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FORGE Setup",
  "version": "1.0.0",
  "identifier": "de.vanturis.forge.setup",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FORGE Setup",
        "width": 760,
        "height": 500,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#14171d",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../desktop/src-tauri/icons/icon.ico"],
    "publisher": "Vanturis",
    "copyright": "Copyright © 2026 Vanturis UG (haftungsbeschränkt)"
  }
}
